{
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/blog/ai-receptionist-era-service-businesses.html",
      "destination": "/journal/ai-automation-for-small-business/",
      "permanent": true
    },
    {
      "source": "/blog/website-is-your-flagship.html",
      "destination": "/brand-web-ai/",
      "permanent": true
    },
    {
      "source": "/blog/premium-brands-refuse-price-competition.html",
      "destination": "/journal/building-a-strong-brand-system/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}